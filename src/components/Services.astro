---
import { services } from "../data/services";

const cardIcons: Record<string, string> = {
  salud: "fa-solid fa-notes-medical",
  vida: "fa-solid fa-people-roof",
  auto: "fa-solid fa-car-side",
  comercial: "fa-solid fa-store",
};
---

<section id="servicios" class="pt-20 pb-10 bg-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-brand-700 font-semibold text-xs uppercase tracking-wider block mb-2">
        Coberturas Principales
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900">
        Servicios de Asesoría Integral
      </h2>
      <p class="text-slate-600 mt-3 text-sm sm:text-base">
        Selecciona un servicio para conocer más detalles sobre cada tipo de póliza.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        services.map((service) => (
          <div class="services-card bg-white rounded-2xl p-6 border border-slate-200 flex flex-col justify-between group">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center text-2xl mb-6 group-hover:bg-brand-600 group-hover:text-white transition-colors">
                <i class={cardIcons[service.key]} />
              </div>
              <h3 class="font-heading text-xl font-bold text-slate-900 mb-2">{service.title}</h3>
              <p class="text-slate-600 text-sm mb-6 leading-relaxed">{service.excerpt}</p>
            </div>
            <button
              type="button"
              data-open-service={service.key}
              class="w-full py-2.5 px-4 rounded-xl border border-brand-200 text-brand-700 font-semibold text-sm transition-all hover:bg-brand-600 hover:text-white hover:border-brand-600 group-hover:border-brand-600 group-hover:shadow-[0_0_16px_rgba(37,99,235,0.35)] flex items-center justify-center gap-2"
            >
              Ver Detalles <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div
  id="service-modal"
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4"
>
  <div class="bg-white rounded-3xl max-w-xl w-full p-6 sm:p-8 relative shadow-2xl">
    <button
      type="button"
      id="modal-close"
      class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 text-xl p-2"
      aria-label="Cerrar detalles"
    >
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div id="modal-content"></div>
  </div>
</div>

<script>
  import { services } from "../data/services";

  const modal = document.getElementById("service-modal");
  const modalContent = document.getElementById("modal-content");

  function openService(key?: string) {
    const service = services.find((s) => s.key === key);
    if (!service || !modal || !modalContent) return;

    modalContent.innerHTML = `
      <div class="w-12 h-12 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center text-2xl mb-4">
        <i class="${service.icon}"></i>
      </div>
      <h3 class="font-heading text-2xl font-bold text-slate-900 mb-2">${service.title}</h3>
      <p class="text-slate-600 text-sm mb-6 leading-relaxed">${service.modalDescription}</p>
      <h4 class="font-bold text-slate-900 text-sm mb-3">Características principales:</h4>
      <ul class="space-y-2.5 mb-6 text-sm text-slate-600">
        ${service.features
          .map(
            (feature) =>
              `<li class="flex items-start gap-2"><i class="fa-solid fa-check text-brand-600 mt-1"></i> <span>${feature}</span></li>`
          )
          .join("")}
      </ul>
      <a
        href="#contacto"
        data-close-modal
        class="w-full bg-brand-800 hover:bg-brand-900 text-white font-bold py-3 rounded-xl text-center block transition-colors"
      >
        Solicitar Cotización con Anahís
      </a>
    `;

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-open-service]").forEach((button) => {
    button.addEventListener("click", () => openService(button.dataset.openService));
  });

  document.getElementById("modal-close")?.addEventListener("click", closeModal);

  modalContent?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("[data-close-modal]")) closeModal();
  });

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeModal();
  });
</script>

<style>
  .services-card {
    position: relative;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .services-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37, 99, 235, 0.75);
    box-shadow:
      inset 0 0 0 1px rgba(37, 99, 235, 0.75),
      0 0 16px rgba(37, 99, 235, 0.35),
      0 0 42px rgba(37, 99, 235, 0.22),
      0 10px 24px rgba(15, 23, 42, 0.12);
  }
</style>

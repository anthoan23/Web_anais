---
import { SITE, whatsappUrl } from "../data/site";
---

<section id="contacto" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-brand-700 font-semibold text-xs uppercase tracking-wider block mb-2">
        Canales de Atención
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900">
        Ubicación &amp; Contacto Directo
      </h2>
      <p class="text-slate-600 mt-2 text-sm sm:text-base">
        Ponte en contacto con {SITE.name} de forma inmediata.
      </p>
    </div>

    <!-- Panel principal: WhatsApp -->
    <div class="bg-brand-950 rounded-3xl p-6 sm:p-10 text-white shadow-xl flex flex-col lg:flex-row lg:items-center gap-10">
      <div class="lg:flex-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 text-xs font-bold uppercase tracking-wider">
          <i class="fa-solid fa-bolt"></i>
          Respuesta rápida
        </div>
        <h3 class="font-heading text-2xl font-bold text-white mt-3">Contacto directo por WhatsApp</h3>
        <p class="text-brand-200 text-sm mt-3 leading-relaxed">
          Toca el botón y me cuentas tu caso desde el chat: la consulta inicial es gratuita y sin
          compromiso. {SITE.shortName} te responde personalmente, sin intermediarios.
        </p>

        <ul class="mt-7 space-y-3.5">
          {
            [
              "Respuesta el mismo día laborable",
              "Sin formularios ni esperas",
              "Consulta inicial siempre gratuita",
            ].map((item) => (
              <li class="flex items-center gap-3 text-sm font-medium text-brand-100">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#25D366]/20 text-[#7ee2a8]">
                  <i class="fa-solid fa-check text-xs"></i>
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:w-80 shrink-0">
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 rounded-xl shadow-md transition-all flex items-center justify-center gap-2.5"
        >
          <i class="fa-brands fa-whatsapp text-xl"></i>
          Escribir al {SITE.phoneDisplay}
        </a>

          <p class="mt-4 text-center text-xs text-brand-300">
            ¿Prefieres correo? Escríbeme a{" "}
            <a href={`mailto:${SITE.emails[0]}`} class="underline underline-offset-2 hover:text-white">
            {SITE.emails[0]}
          </a>
        </p>
      </div>
    </div>

    <!-- Tres cards secundarias -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
      <div class="contact-card bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3 flex flex-col">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-brand-600 text-white flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <h3 class="font-heading text-base font-bold text-slate-900">Dirección de Oficina</h3>
        </div>
        <p class="text-slate-600 text-sm leading-relaxed">
          {SITE.address.line1}<br />
          {SITE.address.line2}<br />
          <span class="font-semibold text-brand-800">{SITE.address.line3}</span>
        </p>
      </div>

      <div class="contact-card bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm space-y-3 flex flex-col">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-brand-600 text-white flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-envelope-open-text"></i>
          </div>
          <h3 class="font-heading text-base font-bold text-slate-900">Correos Electrónicos</h3>
        </div>
        <div class="space-y-2 text-sm">
          {
            SITE.emails.map((email) => (
              <a
                href={`mailto:${email}`}
                class="flex items-center gap-2 font-medium text-brand-700 hover:underline break-all"
              >
                <i class="fa-regular fa-envelope text-slate-400 shrink-0" /> {email}
              </a>
            ))
          }
        </div>
      </div>

      <div class="contact-card bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 flex flex-col">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-brand-600 text-white flex items-center justify-center text-lg shrink-0">
            <i class="fa-solid fa-share-nodes"></i>
          </div>
          <h4 class="font-bold text-slate-900 text-sm">Redes Sociales</h4>
        </div>
        <div class="flex flex-col gap-3 mt-auto">
          <a
            href={SITE.tiktok.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-sm font-semibold hover:bg-brand-600 transition-colors"
          >
            <i class="fa-brands fa-tiktok text-lg"></i>
            <span class="font-normal text-white/80">{SITE.tiktok.handle}</span>
          </a>
          <a
            href={SITE.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2.5 px-4 py-2.5 rounded-xl text-white text-sm font-semibold transition-opacity hover:opacity-85"
            style="background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)"
          >
            <i class="fa-brands fa-instagram text-lg"></i>
            <span class="font-normal text-white/80">{SITE.instagram.handle}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37, 99, 235, 0.75);
    box-shadow:
      inset 0 0 0 1px rgba(37, 99, 235, 0.75),
      0 0 16px rgba(37, 99, 235, 0.35),
      0 0 42px rgba(37, 99, 235, 0.22),
      0 10px 24px rgba(15, 23, 42, 0.12);
  }
</style>

---
import { whatsappUrl } from "../data/site";
---

<a
  href={whatsappUrl("Hola Anahís, quisiera recibir asesoría sobre una póliza")}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-40 bg-emerald-600 hover:bg-emerald-500 text-white w-14 h-14 rounded-full flex items-center justify-center text-2xl shadow-2xl transition-all hover:scale-110"
  aria-label="Contactar por WhatsApp"
>
  <i class="fa-brands fa-whatsapp"></i>
</a>

---
interface Props {
  class?: string;
}

const { class: className = "h-full w-full" } = Astro.props;
---

<img
  src="/logo-blanco.png"
  alt="Logo de Anahís Prieto: familia protegida entre dos manos"
  class:list={[className, "object-contain"]}
  width="512"
  height="512"
  loading="eager"
  decoding="async"
/>
